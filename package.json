{
  "name": "scho",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest",
    "test:run": "vitest run",
    "test:run:verbose": "vitest run --reporter=verbose",
    "test:e2e": "playwright test",
    "test:e2e:verbose": "playwright test --reporter=list",
    "test:e2e:ui": "playwright test --ui",
    "db:test": "tsx --env-file=.env scripts/db/test-connection.ts",
    "db:seed:tasks": "npx tsx --env-file=.env scripts/db/seed-tasks.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@radix-ui/react-select": "^2.4.1",
    "argon2": "^0.45.1",
    "dotenv": "^18.0.9",
    "lucide-react": "^1.61.0",
    "next": "16.4.2",
    "next-auth": "5.0.0-beta.32",
    "pg": "^8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "prettier": "3.10.1",
    "prisma": "7.10.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.5"
  },
  "packageManager": "pnpm@12.4.1"
}
